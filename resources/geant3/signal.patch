+      SUBROUTINE SIGNAL_DECAY_GG(MOTHER,Q)
+C Explicit isotropic prompt decay of a pseudoscalar into two photons.
+      REAL MOTHER(5),Q(5,2),R(2),BETA(3),REST(3)
+      REAL MASS,GAMMA,B2,CT,ST,PHI,DOT,COEF,SGN
+      MASS=SQRT(MOTHER(4)**2-MOTHER(1)**2-MOTHER(2)**2
+     &          -MOTHER(3)**2)
+      GAMMA=MOTHER(4)/MASS
+      B2=0.
+      DO I=1,3
+        BETA(I)=MOTHER(I)/MOTHER(4)
+        B2=B2+BETA(I)**2
+      ENDDO
+      CALL GRNDM(R,2)
+      CT=2.*R(1)-1.
+      ST=SQRT(MAX(0.,1.-CT*CT))
+      PHI=6.283185307179586*R(2)
+      REST(1)=MASS*.5*ST*COS(PHI)
+      REST(2)=MASS*.5*ST*SIN(PHI)
+      REST(3)=MASS*.5*CT
+      DOT=0.
+      DO I=1,3
+        DOT=DOT+BETA(I)*REST(I)
+      ENDDO
+      DO K=1,2
+        SGN=3.-2.*K
+        COEF=GAMMA*MASS*.5
+        IF(B2.GT.1.E-20)COEF=COEF+(GAMMA-1.)*SGN*DOT/B2
+        DO I=1,3
+          Q(I,K)=SGN*REST(I)+COEF*BETA(I)
+        ENDDO
+        Q(4,K)=GAMMA*(MASS*.5+SGN*DOT)
+        Q(5,K)=Q(4,K)
+      ENDDO
+      DO I=1,4
+        IF(ABS(Q(I,1)+Q(I,2)-MOTHER(I)).GT.1.E-5)
+     &     STOP 'SIGNAL DECAY NONCONSERVATION'
+      ENDDO
+      END
